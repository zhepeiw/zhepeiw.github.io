---
import Icon from "./Icon.astro";

type IconName =
  | "audio"
  | "bibtex"
  | "code"
  | "link"
  | "paper"
  | "poster"
  | "slides"
  | "video"
  | "webpage";

interface StandardLinkItem {
  label: string;
  href: string;
  newTab?: boolean;
  icon: IconName;
}

interface BibtexActionItem {
  label: string;
  icon: "bibtex";
  action: "bibtex";
  publicationId: string;
  publicationTitle: string;
  bibtex: string;
}

type LinkItem = StandardLinkItem | BibtexActionItem;

interface Props {
  links: LinkItem[];
}

const { links } = Astro.props;
---

<div class="action-links">
  {
    links.map((link) => (
      "action" in link ? (
        <button
          class="action-links__item"
          type="button"
          data-bibtex-trigger
          data-publication-id={link.publicationId}
          data-publication-title={link.publicationTitle}
          data-bibtex={link.bibtex}
          aria-haspopup="dialog"
        >
          <Icon name={link.icon} />
          <span>{link.label}</span>
        </button>
      ) : (
        <a class="action-links__item" href={link.href} target="_blank" rel="noreferrer">
          <Icon name={link.icon} />
          <span>{link.label}</span>
        </a>
      )
    ))
  }
</div>
